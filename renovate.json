{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s+ARG HOMEPAGE_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/release\\.yaml$/"
      ],
      "matchStrings": [
        "github\\.com/andygodish/upver/releases/download/v(?<currentValue>[^/]+)/upver-linux-amd64"
      ],
      "depNameTemplate": "andygodish/upver",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^docker-compose\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s+ghcr\\.io/andygodish/homepage:(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "ghcr.io/andygodish/homepage",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackagePrefixes": [
        "ghcr.io/andygodish/"
      ],
      "versioning": "loose",
      "registryUrls": [
        "https://ghcr.io"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions dependencies"
    }
  ],
  "docker-compose": {
    "enabled": false
  }
}
